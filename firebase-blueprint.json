{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account metadata and preferences isolated from public profiles.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "soundEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "soundEnabled", "createdAt", "updatedAt"]
    },
    "UserCompletion": {
      "title": "UserCompletion",
      "description": "Private per-puzzle completion record for a user across the 6-month archive and daily puzzles.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "puzzleDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "bestScore": {
          "type": "integer"
        },
        "bestTimeSeconds": {
          "type": "integer"
        },
        "bestAccuracy": {
          "type": "number"
        },
        "hintsUsed": {
          "type": "integer"
        },
        "mistakes": {
          "type": "integer"
        },
        "stars": {
          "type": "integer"
        },
        "attempts": {
          "type": "integer"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "puzzleDate",
        "bestScore",
        "bestTimeSeconds",
        "bestAccuracy",
        "hintsUsed",
        "mistakes",
        "stars",
        "attempts",
        "completedAt",
        "updatedAt"
      ]
    },
    "PlayerProfile": {
      "title": "PlayerProfile",
      "description": "Public competitive player profile without PII for global standings and social recognition.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "avatarId": {
          "type": "string",
          "enum": ["loupe", "owl", "lighthouse", "compass", "monstera", "astrolabe", "chalet", "saxophone"]
        },
        "motto": {
          "type": "string",
          "maxLength": 120
        },
        "isPublic": {
          "type": "boolean"
        },
        "totalScore": {
          "type": "integer"
        },
        "puzzlesSolved": {
          "type": "integer"
        },
        "currentStreak": {
          "type": "integer"
        },
        "bestStreak": {
          "type": "integer"
        },
        "bestTimeSeconds": {
          "type": "integer"
        },
        "totalAccuracySum": {
          "type": "number"
        },
        "lastPlayedDate": {
          "type": "string",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "avatarId",
        "motto",
        "isPublic",
        "totalScore",
        "puzzlesSolved",
        "currentStreak",
        "bestStreak",
        "bestTimeSeconds",
        "totalAccuracySum",
        "lastPlayedDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "PuzzleScore": {
      "title": "PuzzleScore",
      "description": "Best competitive leaderboard score submitted by a verified player for a given daily or archive puzzle date.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "puzzleDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "avatarId": {
          "type": "string",
          "enum": ["loupe", "owl", "lighthouse", "compass", "monstera", "astrolabe", "chalet", "saxophone"]
        },
        "score": {
          "type": "integer"
        },
        "timeSeconds": {
          "type": "integer"
        },
        "accuracy": {
          "type": "number"
        },
        "hintsUsed": {
          "type": "integer"
        },
        "mistakes": {
          "type": "integer"
        },
        "stars": {
          "type": "integer"
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "puzzleDate",
        "displayName",
        "avatarId",
        "score",
        "timeSeconds",
        "accuracy",
        "hintsUsed",
        "mistakes",
        "stars",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account document holding email and UI preferences."
    },
    "/users/{userId}/completions/{puzzleDate}": {
      "schema": { "$ref": "#/entities/UserCompletion" },
      "description": "Per-user completion statistics indexed by YYYY-MM-DD puzzle date."
    },
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/PlayerProfile" },
      "description": "Public competitive player profile and cumulative season statistics."
    },
    "/puzzleScores/{scoreId}": {
      "schema": { "$ref": "#/entities/PuzzleScore" },
      "description": "Public leaderboard entries keyed deterministically as {puzzleDate}_{userId}."
    }
  }
}
