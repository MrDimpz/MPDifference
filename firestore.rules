rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core security primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPuzzleDate(dateStr) {
      return dateStr is string && dateStr.size() == 10 && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidAvatarId(avatarId) {
      return avatarId is string && avatarId in [
        'loupe',
        'owl',
        'lighthouse',
        'compass',
        'monstera',
        'astrolabe',
        'chalet',
        'saxophone'
      ];
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'soundEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'soundEnabled', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.soundEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserCompletion(data) {
      return data.keys().hasAll([
          'uid', 'puzzleDate', 'bestScore', 'bestTimeSeconds',
          'bestAccuracy', 'hintsUsed', 'mistakes', 'stars',
          'attempts', 'completedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'puzzleDate', 'bestScore', 'bestTimeSeconds',
          'bestAccuracy', 'hintsUsed', 'mistakes', 'stars',
          'attempts', 'completedAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidPuzzleDate(data.puzzleDate)
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 25000
        && data.bestTimeSeconds is int && data.bestTimeSeconds >= 1 && data.bestTimeSeconds <= 86400
        && data.bestAccuracy is number && data.bestAccuracy >= 0 && data.bestAccuracy <= 100
        && data.hintsUsed is int && data.hintsUsed >= 0 && data.hintsUsed <= 20
        && data.mistakes is int && data.mistakes >= 0 && data.mistakes <= 100
        && data.stars is int && data.stars >= 1 && data.stars <= 3
        && data.attempts is int && data.attempts >= 1 && data.attempts <= 10000
        && data.completedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'avatarId', 'motto', 'isPublic',
          'totalScore', 'puzzlesSolved', 'currentStreak', 'bestStreak',
          'bestTimeSeconds', 'totalAccuracySum', 'lastPlayedDate',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'avatarId', 'motto', 'isPublic',
          'totalScore', 'puzzlesSolved', 'currentStreak', 'bestStreak',
          'bestTimeSeconds', 'totalAccuracySum', 'lastPlayedDate',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 32
        && isValidAvatarId(data.avatarId)
        && data.motto is string && data.motto.size() <= 120
        && data.isPublic is bool && data.isPublic == true
        && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 100000000
        && data.puzzlesSolved is int && data.puzzlesSolved >= 0 && data.puzzlesSolved <= 10000
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000
        && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 10000
        && data.bestTimeSeconds is int && data.bestTimeSeconds >= 0 && data.bestTimeSeconds <= 86400
        && data.totalAccuracySum is number && data.totalAccuracySum >= 0 && data.totalAccuracySum <= 1000000
        && data.lastPlayedDate is string && (data.lastPlayedDate.size() == 0 || isValidPuzzleDate(data.lastPlayedDate))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPuzzleScore(data) {
      return data.keys().hasAll([
          'uid', 'puzzleDate', 'displayName', 'avatarId', 'score',
          'timeSeconds', 'accuracy', 'hintsUsed', 'mistakes', 'stars',
          'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'puzzleDate', 'displayName', 'avatarId', 'score',
          'timeSeconds', 'accuracy', 'hintsUsed', 'mistakes', 'stars',
          'isPublic', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidPuzzleDate(data.puzzleDate)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 32
        && isValidAvatarId(data.avatarId)
        && data.score is int && data.score >= 0 && data.score <= 25000
        && data.timeSeconds is int && data.timeSeconds >= 1 && data.timeSeconds <= 86400
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100
        && data.hintsUsed is int && data.hintsUsed >= 0 && data.hintsUsed <= 20
        && data.mistakes is int && data.mistakes >= 0 && data.mistakes <= 100
        && data.stars is int && data.stars >= 1 && data.stars <= 3
        && data.isPublic is bool && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private User Account (PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['soundEnabled', 'updatedAt']);
      allow delete: if false;

      // Private User Puzzle Completions (Master Gate -> /users/{userId})
      match /completions/{puzzleDate} {
        allow get: if isValidId(userId)
          && isValidPuzzleDate(puzzleDate)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidPuzzleDate(puzzleDate)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserCompletion(incoming())
          && incoming().puzzleDate == puzzleDate
          && incoming().completedAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidPuzzleDate(puzzleDate)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserCompletion(incoming())
          && incoming().uid == existing().uid
          && incoming().puzzleDate == existing().puzzleDate
          && incoming().completedAt == existing().completedAt
          && incoming().updatedAt == request.time
          && incoming().attempts >= existing().attempts
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'bestScore', 'bestTimeSeconds', 'bestAccuracy',
            'hintsUsed', 'mistakes', 'stars', 'attempts', 'updatedAt'
          ]);
        allow delete: if false;
      }
    }

    // Public Player Profiles (No PII)
    match /profiles/{userId} {
      allow get: if isValidId(userId) && (existing().isPublic == true || isOwner(userId));
      allow list: if resource.data.isPublic == true;
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidPlayerProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidPlayerProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarId', 'motto', 'updatedAt'])
          || (
            incoming().totalScore >= existing().totalScore
            && incoming().puzzlesSolved >= existing().puzzlesSolved
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'avatarId', 'motto',
              'totalScore', 'puzzlesSolved', 'currentStreak',
              'bestStreak', 'bestTimeSeconds', 'totalAccuracySum',
              'lastPlayedDate', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // Public Competitive Leaderboard Scores ({puzzleDate}_{userId})
    match /puzzleScores/{scoreId} {
      allow get: if isValidId(scoreId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;
      allow create: if isValidId(scoreId)
        && isVerifiedUser()
        && isValidPuzzleScore(incoming())
        && scoreId == (incoming().puzzleDate + '_' + request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(scoreId)
        && isVerifiedUser()
        && isValidPuzzleScore(incoming())
        && existing().uid == request.auth.uid
        && scoreId == (existing().puzzleDate + '_' + request.auth.uid)
        && incoming().uid == existing().uid
        && incoming().puzzleDate == existing().puzzleDate
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().score >= existing().score
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarId', 'score', 'timeSeconds',
          'accuracy', 'hintsUsed', 'mistakes', 'stars', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
